e_status":{"pdb_format_compatible":"Y","process_site":"BNL","recvd_initial_deposition_date":"1993-10-08T00:00:00.000+00:00","status_code":"REL"},"pdbx_nmr_ensemble":{"conformer_selection_criteria":"all calculated structures submitted","conformers_calculated_total_number":6,"conformers_submitted_total_number":6},"pdbx_nmr_refine":[{"details":"A SET OF SIX STRUCTURES WERE OBTAINED USING METRIC MATRIX DISTANCE GEOMETRY, AND SUBSEQUENTLY REFINED BY DISTANCE-RESTRAINED MOLECULAR DYNAMICS USING A SET OF INTER-PROTON DISTANCES AND DIHEDRAL ANGLE RESTRAINTS DERIVED FROM THE NMR DATA. THE SIX DISTANCE-REFINED STRUCTURES WERE REFINED FURTHER USING RELAXATION-MATRIX BASED NOE INTENSITY-RESTRAINED MOLECULAR DYNAMICS. THE FINAL SIX STRUCTURES WERE OBTAINED BY TAKING THE AVERAGE COORDINATES OF THE LAST 2 PS OF THE DYNAMICS DURING RELAXATION MATRIX REFINEMENT AND MINIMIZED. THE R(1/6) VALUE WAS USED TO REFINE THE STRUCTURE DURING RELAXATION MATRIX REFINEMENT. THE R(1/6) FACTOR AND THE RMS DEVIATIONS FROM IDEAL GEOMETRY FOR THE SIX FINAL STRUCTURES ARE: MODEL1 MODEL2 MODEL3 MODEL4 MODEL5 MODEL6 R(1/6) FACTOR 0.021 0.016 0.022 0.026 0.024 0.027 BOND (ANG) 0.009 0.008 0.009 0.011 0.009 0.011 ANGLES (DEG) 2.949 3.085 3.286 3.853 3.038 3.157 IMPROPERS (DEG) 0.285 0.221 0.267 0.235 0.243 0.248","method":"DISTANCE GEOMETRY, MOLECULAR DYNAMICS","software_ordinal":1}],"pdbx_nmr_software":[{"authors":"BRUNGER","classification":"refinement","name":"X-PLOR","ordinal":1}],"pdbx_vrpt_summary":{"attempted_validation_steps":"molprobity,validation-pack,coreclust,chemicalshiftanalysis,validation_schema,percentiles,writepdf,writexml,writecif","ligands_for_buster_report":"N","report_creation_date":"2026-03-04T19:39:00.000+00:00"},"pdbx_vrpt_summary_geometry":[{"angles_RMSZ":1.67,"bonds_RMSZ":0.74,"clashscore":14.92,"clashscore_full_length":15.15,"num_H_reduce":1500,"num_angles_RMSZ":4872,"num_bonds_RMSZ":3144}],"rcsb_accession_info":{"deposit_date":"1993-10-08T00:00:00.000+00:00","has_released_experi