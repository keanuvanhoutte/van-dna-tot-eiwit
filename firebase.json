{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "transcripten/**",
      "🎥*",
      "tools/**",
      "dist/**",
      "dist-files.json",
      "**/*.orig.js",
      "README.md",
      "FIXES.md",
      "Start app.bat"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "data/pdb/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}
